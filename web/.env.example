# Database Configuration (PostgreSQL)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/invoice_db"

# JWT Secret for Mobile Client Authentication (REQUIRED in production — no fallback)
JWT_SECRET="change-me-generate-with-openssl-rand-hex-32"

# NextAuth Configuration (Admin & Staff web portal, REQUIRED in production)
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# S3 Private Bucket Configuration (MinIO / AWS S3 / Cloudflare R2 / LocalStack)
# Local dev options: MinIO on :9000, or LocalStack edge on :4566.
# Endpoint MUST be reachable from the phone (LAN IP, never localhost).
AWS_REGION="us-east-1"
S3_ENDPOINT="https://s3.jamicore.com"
S3_BUCKET_NAME="invoice-uploads"
S3_FORCE_PATH_STYLE="true"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Local dev without S3: set ALLOW_S3_MOCK=true to bypass HeadObject (never in prod)
ALLOW_S3_MOCK=""

# Client auth: admin-created user ID + password (bcrypt). No OTP.
# Admins create credentials at /admin/clients; clients sign in via
# POST /api/client-auth/login. Nothing to configure here.

# Seed (dev only unless ALLOW_SEED=true). Never commit real passwords.
SEED_ADMIN_EMAIL="admin@jamicore.com"
SEED_STAFF_EMAIL="staff@jamicore.com"
SEED_ADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""
ALLOW_SEED=""

# Maker-checker (Phase 2.3): verified -> collected must be a DIFFERENT account
# than the one that set verified (403 otherwise). Default "true".
ENFORCE_MAKER_CHECKER="true"
# Admin exemption: only when "true" may an admin collect their own verified
# invoice. Default "false" (admins are NOT exempt).
ENFORCE_MAKER_CHECKER_ADMIN_EXEMPT="false"
# WARNING — single-staff deadlock: if the office has only ONE active staff
# account, ENFORCE_MAKER_CHECKER=true makes `collected` unreachable for every
# invoice that person verifies (the admin counts as a different account ONLY
# when the verifier is not the admin themself — i.e. an admin can still
# collect staff-verified invoices, and vice versa, but nobody can collect
# their own). With a single human in the office, either add a second account
# or set ENFORCE_MAKER_CHECKER=false (not recommended).
